# Copy this file to .env for local `vercel dev` testing, and add the same
# two variables in your Vercel Project → Settings → Environment Variables
# for Production/Preview/Development.
#
# Get these from https://dashboard.razorpay.com/app/keys
# Start with your TEST MODE keys (they're prefixed rzp_test_...).

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Get these from https://merchant.cashfree.com/merchants/login
# Start with your TEST MODE credentials (CASHFREE_ENV=TEST).
# Used by api/cashfree/create-order.ts, api/cashfree/verify-payment.ts,
# and (optionally) api/cashfree/webhook.ts.

CASHFREE_APP_ID=TEST_xxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_SECRET_KEY=cfsk_ma_test_xxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_ENV=TEST

# Optional payment split (defaults: 5% booking token paid online, 25% at project start, rest on completion).
BOOKING_TOKEN_PERCENT=5
START_ADVANCE_PERCENT=25
# Same values for the browser (shown in the quotation). Keep both pairs equal.
VITE_BOOKING_TOKEN_PERCENT=5
VITE_START_ADVANCE_PERCENT=25

# Razorpay webhook secret (optional, for the booking Gmail alert if the tab closes mid-payment).
# Dashboard → Settings → Webhooks → https://<site>/api/booking/webhook, event payment.captured
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Booking notification emails (Resend) — used by api/_lib/sendEmail.ts
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_TO=yourname@gmail.com   # booking notifications arrive in THIS Gmail
# Needed to email CLIENTS: verify a domain in Resend and set EMAIL_FROM to an address on it.
# (Without it, Resend only delivers to your own account email, so clients will not receive the quotation.)
EMAIL_FROM="Nikhil Paharia <bookings@yourdomain.com>"

# ── Easiest way to email CLIENTS (no domain needed): send through your own Gmail ──
# Google Account → Security → 2-Step Verification → App passwords → create one.
# When these two are set, they are used instead of Resend.
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ── Send the booking PDF to the CLIENT'S WhatsApp (Meta WhatsApp Cloud API) ──
# 1) developers.facebook.com → create app → add "WhatsApp" → note the Phone Number ID
# 2) Business Settings → System users → generate a permanent token (whatsapp_business_messaging)
# 3) WhatsApp Manager → Message templates → create template "booking_confirmation":
#      Category: Utility   Language: English (en)
#      Header: Document (sample: any PDF)
#      Body: Hi {{1}}, thank you for booking {{2}}! Your booking confirmation and quotation are attached. I'll contact you shortly. - Nikhil Paharia
#    Wait until its status is "Approved".
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=booking_confirmation
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v23.0
# Only used by scripts/whatsapp-check.mjs (NOT by the website): your WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
